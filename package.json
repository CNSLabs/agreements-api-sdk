{
  "name": "agreements-api-sdk",
  "version": "0.0.1",
  "private": true,
  "description": "Open-source Agreements API client, playground, and full-stack Shodai Reference App.",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "build": "pnpm -r build",
    "build:client": "pnpm --filter @shodai-network/agreements-api-client build",
    "build:playground": "pnpm --filter agreements-api-playground build",
    "build:reference-app": "pnpm --filter shodai-reference-app build",
    "build:oauth-cli": "pnpm --filter oauth-connect-cli build",
    "dev": "pnpm --filter shodai-reference-app dev:start",
    "dev:stop": "pnpm --filter shodai-reference-app dev:stop",
    "dev:playground": "pnpm --filter agreements-api-playground dev",
    "oauth": "pnpm --filter oauth-connect-cli run shodai-oauth --",
    "lint": "pnpm -r lint"
  },
  "pnpm": {
    "overrides": {
      "axios@1": "^1.20.0",
      "brace-expansion@1": "^1.1.20",
      "brace-expansion@2": "^2.1.6",
      "brace-expansion@5": "^5.0.11",
      "browserslist@4": "^4.28.7",
      "fast-uri@3": "^3.1.7",
      "ip-address@10": "^10.3.1",
      "js-yaml@4": "^4.3.2",
      "multer@2": "^2.3.0",
      "nanoid@3": "^3.3.18",
      "postcss@8": "^8.5.18",
      "proxy-addr@2": "^2.0.8",
      "socket.io-parser@4": "^4.2.7",
      "source-map-js@1": "^1.2.2",
      "ws@8": "^8.21.0",
      "ws@7": "^7.5.11"
    }
  }
}
